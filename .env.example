SECRET_KEY=change-me-for-local-development
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,safelensai-api.prodisyn.com

# --- Local PostgreSQL Database ---
LOCAL_DB_NAME=safelens_general_db
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=Safelens1234
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432

# --- Cloud AWS RDS Database ---
CLOUD_DB_NAME=
CLOUD_DB_USER=
CLOUD_DB_PASSWORD= 
CLOUD_DB_HOST=
CLOUD_DB_PORT=


PUBLIC_BASE_URL=http://127.0.0.1:8000
AMPLIFY_URL=
EXTRA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SYSTEM_STORAGE_DIR=../storage
SYSTEM_STORAGE_ALT_DIRS=
ENABLE_DB_INIT_ON_STARTUP=0

SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_HTTPONLY=False
X_FRAME_OPTIONS=DENY

AWS_REGION=ap-south-1
AWS_STORAGE_BUCKET_NAME=safelensai-data
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_SENDER=
AWS_SES_REGION_NAME=ap-south-1
AWS_WHATSAPP_TEMPLATE_TEXT=safelens_incident_alert_text
AWS_WHATSAPP_TEMPLATE_MEDIA=safelens_incident_alert_media

# --- Notification polling ---
ALERT_POLL_INTERVAL_SECONDS=3
ALERT_MAX_AGE_SECONDS=150
ALERT_CRITICAL_MAX_AGE_SECONDS=150
ALERT_CRITICAL_EVENT_TYPES=FALL,INTRUSION,FALL_DETECTED,INTRUSION_DETECTED,UNATTENDED_OBJECT
INCIDENT_STREAM_POLL_SECONDS=1.0
INCIDENT_STREAM_HEARTBEAT_SECONDS=15

DEPLOYMENT_MODE=LOCAL
SQS_QUEUE_URL=

# --- MQTT Local Configuration ---
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=safelens/events/prodisyn_local

#---Notification--
ENABLE_EVENT_ALERTS=True


DAILY_SUMMARY_TIME=15:35
DAILY_SUMMARY_START_TIME=08:00
DAILY_SUMMARY_END_TIME=18:00


# --- Microsoft Graph / Teams 1:1 Notifications ---
MS_CLIENT_ID=
MS_TENANT_ID=
MS_TOKEN_CACHE_FILE=ms_token_cache.json
# --- AI Assistant (Ollama) ---
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
ASSISTANT_MODEL=gemma4:31b
ASSISTANT_ENABLED=True
ASSISTANT_RATE_LIMIT_PER_HOUR=30
ASSISTANT_MAX_TOOL_ROUNDS=5
ASSISTANT_LLM_TIMEOUT_SECONDS=60
# Sends snapshot images to the LLM provider. Keep False unless approved.
ASSISTANT_VISION_ENABLED=False
